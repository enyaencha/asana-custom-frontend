# .env - Local MySQL Server Configuration

# Local MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=test
DB_NAME=asana_local_cache

# Local Server Configuration
LOCAL_PORT=3002
MAIN_SERVER_URL=http://localhost:3001/api

# Sync Configuration
SYNC_INTERVAL=30
BATCH_SIZE=50
MAX_RETRIES=3
AUTO_SYNC=true

# Development
NODE_ENV=development